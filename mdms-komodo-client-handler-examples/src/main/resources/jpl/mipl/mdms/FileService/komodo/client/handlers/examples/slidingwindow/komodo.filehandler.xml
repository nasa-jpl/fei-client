<fei:handlerplugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:fei="http://mdms.jpl.nasa.gov/schema/pluginhandler" xsi:schemaLocation="http://mdms.jpl.nasa.gov/schema/pluginhandler http://mdms.jpl.nasa.gov/schema/fei/fileventhandlerplugin.xsd">
    <fei:name>Komodo Sliding Window Database Tracking Handler</fei:name>
    <fei:id>fei.komodo.slidingwindow.filehandler</fei:id>
    <fei:version>1.0.0</fei:version>
    <fei:description>Example Sliding Window (FIFO) Database Tracking Handler</fei:description>
    <fei:org>gov.nasa.jpl.mipl.mdms.fei</fei:org>
    <fei:handler>
        <fei:implementation>jpl.mipl.mdms.FileService.komodo.client.handlers.examples.slidingwindow.SlidingWindowFileHandler</fei:implementation>
        <fei:properties> 
            <fei:property name="disk.soft.limit"  value="200" desc="max memory to use, in megs"/>
            <fei:property name="disk.total.space" value="1000"/>
            <fei:property name="disk.cleanup.ratio" value=".30"/>
            <fei:property name="prune.empty.directories" value="false"/>
            <fei:property name="preserve.newer.files" value="false"/>
            <fei:property name="query.batch.size" value="25"/>
            <fei:property name="log.cleanup.messages" value="true"/>            
            <fei:property name="slidingwindow.database.implementation" value="jpl.mipl.mdms.FileService.komodo.client.handlers.examples.slidingwindow.SlidingWindowDerbyFileDatabase"/>
        </fei:properties>
    </fei:handler>    
</fei:handlerplugin>
