<fei:domain xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:fei="http://mdms.jpl.nasa.gov/schema/fei" xsi:schemaLocation="http://mdms.jpl.nasa.gov/schema/fei http://mdms.jpl.nasa.gov/schema/fei/domain.xsd">
